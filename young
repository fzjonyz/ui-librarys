		frames += 1
		local now = os.clock()
		if now - last >= 0.5 then
			fps = math.floor(frames / (now - last) + 0.5)
			frames = 0
			last = now
		end

		if State.MiniIdentity then
			State.MiniIdentity.Text = LP.DisplayName .. " · " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers
		end

		if State.MiniStats then
			local ping = math.floor((LP:GetNetworkPing() or 0) * 1000 + 0.5)
			State.MiniStats.Text = string.format("%d FPS  •  %d ms", fps, ping)
			State.MiniStats.TextColor3 = State.pingStatusColor(ping)
		end
	end)

	task.wait(0.1)
end)


