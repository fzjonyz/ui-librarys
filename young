State.registerProfileControl = function(page, titleText, kind, controller)
	if not page or page.Name == "Perfiles" or type(controller) ~= "table" then return end
	local base = tostring(page.Name) .. "|" .. tostring(titleText)
	local key = base
	local suffix = 2
