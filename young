local Window = {}

local function selectTab(name)
	if type(name) ~= "string" or not Pages[name] then return false end
	refreshTabs(name)
	return true
end

function Window:SetTitle(text)
	HeaderTitle.Text = tostring(text)
end

function Window:Tab(options)
	local name, width = options, 88
	if type(options) == "table" then
		name = options.Name or options.name
		width = options.Width or options.width or 88
	end
	if type(name) ~= "string" or name == "" then return nil end
	local page = Pages[name]
	if not page then
		local order = 0
		for _ in pairs(Pages) do order = order + 1 end
		page = addTab(name, width, order + 1)
	end
	if not State.currentTab then
		refreshTabs(name)
	end

	local Tab = {}
	Tab.Name = name
	Tab.Page = page

	function Tab:Section(text)
		addSection(page, text)
	end

	function Tab:Button(text, callback)
		addButton(page, text, callback)
	end

	function Tab:Toggle(text, default, callback)
		local controller = addToggle(page, text, callback)
		if default == true then
			controller:Set(true, true)
		end
		return controller
	end

	function Tab:Slider(text, minimum, maximum, default, callback)
		return addSlider(page, text, minimum, maximum, default, callback)
	end

	function Tab:Dropdown(text, values, default, callback)
		local data = addSelector(page, text, values, callback)
		if default ~= nil then
			data:SetValue(default)
		end
		return data
	end

	function Tab:Textbox(text, placeholder, default, callback)
		local box = addInput(page, text, placeholder, callback)
		if default ~= nil then
			box.Text = tostring(default)
		end
		return box
	end

	function Tab:Label(text, color)
		return addInfoRow(page, "", text, color or C.soft, false, false)
	end

	function Tab:Row(label, value, color, indicator, accent)
		return addInfoRow(page, label or "", value or "", color or C.white,
			indicator == true, accent == true)
	end

	function Tab:Select()
		return selectTab(name)
	end

	return Tab
end

function Window:SelectTab(name)
	return selectTab(name)
end

function Window:SelectedTab()
	return State.currentTab
end

function Window:Minimize()
	setMinimized(true)
end

function Window:Restore()
	setMinimized(false)
end

function Window:SetMinimized(value)
	setMinimized(value == true)
end

function Window:IsMinimized()
	return UiMotion.minimized == true
end

function Window:SetTheme(name)
	return State.applyTheme(name, true)
end

function Window:Destroy()
	if State.running then
		shutdown(false, false)
	end
end

function Library:CreateWindow(options)
	options = options or {}
	if options.Name then
		HeaderTitle.Text = tostring(options.Name)
	end
	State.applyTheme(options.Theme or State.themeName, true)
	return Window
end

Library.new = function(options)
	return Library:CreateWindow(options)
end

Library.Window = function(options)
	return Library:CreateWindow(options)
end

Library.Tab = function(options)
	return Window:Tab(options)
end

do
	local root = getgenv and getgenv() or _G
	root.Library = Library
end

return Library
